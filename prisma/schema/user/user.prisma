model User {
    id       String  @id @default(uuid())
    email    String  @unique
    password String?

    roles      UserRole[] @default([CANDIDATE])
    activeRole UserRole   @default(CANDIDATE)

    status          UserStatus @default(PENDING)
    isEmailVerified Boolean    @default(false)

    provider     AuthProvider @default(CREDENTIALS)
    providerId   String?
    isSocialAuth Boolean      @default(false)

    isDeleted Boolean   @default(false)
    deletedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    candidateProfile CandidateProfile?
    recruiterProfile RecruiterProfile?

    recruiterApplications RecruiterApplication[] @relation("Applicant")

    reviewedRecruiterApplications RecruiterApplication[] @relation("Reviewer")

    @@index([status])
    @@map("users")
}

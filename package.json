{
  "name": "codeshift-backend",
  "version": "0.0.1",
  "type": "module",
  "description": "A production-grade, secure RESTful API for a Developer Assessment Platform built with Node.js, TypeScript, Express, and PostgreSQL using Prisma ORM. Features robust role-based access control (RBAC) for Admins, Recruiters, and Candidates, automated code submission validation frameworks, GCP Social Login, real payment gateway integration (Stripe/bKash/SSLCommerz), secure data parsing using Zod, and optimized caching via Redis.",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format ./src",
    "format:fix": "biome format --write ./src",
    "check": "biome check ./src",
    "check:fix": "biome check --write ./src",
    "stripe:listen": "stripe listen --forward-to localhost:4000/api/v1/payments/webhook",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "express",
    "typescript",
    "prisma",
    "postgresql",
    "jwt-auth",
    "stripe",
    "zod-validation",
    "redis",
    "rbac"
  ],
  "author": "Shorabul Hoque shorabulhoque@yahoo.com",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@stripe/cli": "^1.50.10",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.0",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "resend": "^6.26.0",
    "stripe": "^22.6.1",
    "zod": "^4.5.4"
  }
}
